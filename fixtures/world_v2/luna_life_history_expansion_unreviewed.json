  "records": [
    {
      "record_id": "prehistory-record:luna-life-001",
      "occurred_from": "2007-01-01T00:00:00+08:00",
      "occurred_until": "2010-12-31T23:59:59+08:00",
      "time_precision": "interval",
      "timezone_name": "Asia/Shanghai",
      "statement": "事件：母亲后来讲过，知栀小时候有一阵把塑料夹子从抽屉拿出来，在客厅矮桌上排队。她会按颜色分堆，也会把夹子夹在旧纸板边上拖着走；大人收桌子时，她就把夹子抱回去。家里人说不清她那时几岁，也记不得持续了多久。",
      "participant_refs": [
        "history:person:celia-self",
        "history:person:shen-lan"
      ],
      "location_ref": null,
