    },
    {
      "record_id": "prehistory-record:luna-life-002",
      "occurred_from": "2010-10-01T00:00:00+08:00",
      "occurred_until": "2010-10-31T23:59:59+08:00",
      "time_precision": "month",
      "timezone_name": "Asia/Shanghai",
      "statement": "事件：嘉兴家里一把儿童雨伞的伞骨松了，父亲用细铁丝固定过一次，伞柄缠着一圈发白的胶带。后来雨下得很大时，伞面还是朝外翻了，回家后那把伞被晾在门边，没再修。\n当时感受：伞一翻过去，她就更烦了，鞋袜都湿着。",
      "participant_refs": [
        "history:person:celia-self",
        "history:person:chen-yuan"
      ],
      "location_ref": null,
      "related_record_refs": [],
      "privacy_class": "personal"
    },
    {
      "record_id": "prehistory-record:luna-life-003",
      "occurred_from": "2011-02-01T00:00:00+08:00",
      "occurred_until": "2011-02-28T23:59:59+08:00",
      "time_precision": "month",
      "timezone_name": "Asia/Shanghai",
      "statement": "事件：春节前后，外婆教她用旧扑克牌玩一种配对小游戏，规则中途改过两次。玩到一半有人去厨房，她把手里的牌扣在桌面上，回来后大家各自忘了轮到谁。\n当时感受：规则又改的时候她有点不耐烦，外婆把一张牌当成了另一张，几个人都笑起来。\n后来回看（World 启动前）：后来她还记得那阵笑，输赢倒没人算。",
      "participant_refs": [
        "history:person:celia-self",
        "history:person:grandmother-shen"
      ],
      "location_ref": null,
      "related_record_refs": [],
      "privacy_class": "personal"
    },
    {
      "record_id": "prehistory-record:luna-life-004",
      "occurred_from": "2011-06-01T00:00:00+08:00",
      "occurred_until": "2011-06-30T23:59:59+08:00",
      "time_precision": "month",
      "timezone_name": "Asia/Shanghai",
      "statement": "事件：一个闷热的晚上，家里停电了一小会儿。母亲从冰箱拿出西瓜，父亲找来手电筒，光照在墙上晃来晃去；电很快恢复，西瓜还没吃完。\n当时感受：她先担心冰箱，后来拿着手电筒照墙上的影子，吃瓜时也没再急。",
      "participant_refs": [
        "history:person:celia-self",
        "history:person:shen-lan",
        "history:person:chen-yuan"
      ],
      "location_ref": null,
      "related_record_refs": [
        "prehistory-record:luna-life-001"
      ],
      "privacy_class": "personal"
    },
    {
      "record_id": "prehistory-record:luna-life-005",
      "occurred_from": "2012-11-01T00:00:00+08:00",
      "occurred_until": "2012-11-30T23:59:59+08:00",
      "time_precision": "month",
      "timezone_name": "Asia/Shanghai",
      "statement": "事件：小学一次手工课，知栀和同学甲用纸板做立体贺卡。她挤胶水时出来一大团，纸角立刻软下去，便把它翻到背面压住，继续贴彩纸。收尾时贺卡歪歪地站起来，同学甲说像在点头，两人都笑了。下课后她把卡片带回家，放在书桌上晾干。那天下课后她把贺卡带回家，在书桌上放了两天。\n当时感受：她看着纸角软下去，脸有点发热，赶紧翻过来压在底下。没想到贴完装饰后那张贺卡还站得住，同学甲笑说它像歪着头。",
      "participant_refs": [
        "history:person:celia-self",
        "history:person:classmate-a"
      ],
      "location_ref": null,
      "related_record_refs": [
        "prehistory-record:luna-life-006",
        "prehistory-record:luna-life-011"
      ],
      "privacy_class": "personal"
    },
    {
      "record_id": "prehistory-record:luna-life-006",
      "occurred_from": "2013-04-01T00:00:00+08:00",
      "occurred_until": "2013-04-30T23:59:59+08:00",
      "time_precision": "month",
      "timezone_name": "Asia/Shanghai",
      "statement": "事件：家里一个带弹簧的旧发夹松了，知栀把它放进铁皮糖盒里，隔了几天母亲用钳子把弹簧卡回去。夹子能合上但夹不牢，后来被放在抽屉最里面。\n当时感受：夹子老往下滑，她试了好几回，最后把它搁到糖盒里。",
      "participant_refs": [
        "history:person:celia-self",
        "history:person:shen-lan"
      ],
      "location_ref": null,
      "related_record_refs": [
        "prehistory-record:luna-life-018"
