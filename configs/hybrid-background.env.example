# Load after the existing deployment profile. Interactive DeepSeek settings stay intact.
WORLD_V2_BACKGROUND_PROVIDER=anthropic_subscription
WORLD_V2_BACKGROUND_BASE_URL=http://localhost:8788
WORLD_V2_BACKGROUND_API_KEY=local-proxy
WORLD_V2_BACKGROUND_MODEL=gemini-3.8-flash-medium
WORLD_V2_BACKGROUND_TIMEOUT_SECONDS=90
WORLD_V2_BACKGROUND_OUTPUT_TOKENS=64000
# cmdc-pak can put a complete tool-schema JSON object in an ordinary text block.
# The original role/source validators still decide whether it may be accepted.
WORLD_V2_BACKGROUND_TOOL_RESULT_CARRIER=native_or_json_object
WORLD_V2_BACKGROUND_TOKENS_5H=150000000
WORLD_V2_BACKGROUND_TOKENS_7D=500000000
