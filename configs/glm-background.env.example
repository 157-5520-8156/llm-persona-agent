# Load after the existing application profile; keep interactive DeepSeek unchanged.
# Store WORLD_V2_BACKGROUND_API_KEY in the local .env or process environment, never here.
WORLD_V2_BACKGROUND_PROVIDER=glm
WORLD_V2_BACKGROUND_BASE_URL=https://api.edgefn.net/v1
WORLD_V2_BACKGROUND_MODEL=GLM-5.3-Flash
WORLD_V2_BACKGROUND_REASONING_EFFORT=low
WORLD_V2_BACKGROUND_TIMEOUT_SECONDS=180
WORLD_V2_BACKGROUND_OUTPUT_TOKENS=64000
WORLD_V2_BACKGROUND_TOOL_RESULT_CARRIER=native
# Deployment-local token ceilings, not a provider quota or monetary price claim.
WORLD_V2_BACKGROUND_TOKENS_5H=150000000
WORLD_V2_BACKGROUND_TOKENS_7D=500000000
